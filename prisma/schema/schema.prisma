
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Test {
    id String @id @default(uuid())
    name String
}

// ── Intake ────────────────────────────────────────────────────────────────────

/** Channel through which the intake was conducted. */
enum IntakeMode {
  TEXT
  VOICE
}

/** Lifecycle status of a patient intake session. */
enum IntakeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/**
 * Patient pre-appointment intake record.
 *
 * Stores the full intake conversation transcript and the AI-generated
 * clinical assessment report. Lives in the local Postgres database — not
 * in FHIR-GQL — because intake is proprietary application data.
 *
 * fhir_appointment_id is null until the patient books a doctor appointment
 * after completing intake. Once set, doctors can retrieve the linked intake
 * report by querying on fhir_appointment_id.
 */
model Intake {
  id                  Int          @id @default(autoincrement())
  /** Better Auth user ID of the patient who started the intake. */
  user_id             String
  org_id              String?
  /** FHIR Patient.id (integer) — populated so doctors can correlate. */
  patient_fhir_id     Int?
  mode                IntakeMode
  status              IntakeStatus @default(IN_PROGRESS)
  /** Chat transcript: [{ role: "user"|"assistant", content: string }] */
  conversation        Json?
  /** AI-generated clinical assessment (risk_level, differential_diagnosis, etc.) */
  report              Json?
  /** Set after the patient books a FHIR appointment following this intake. */
  fhir_appointment_id Int?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  @@index([user_id])
  @@index([fhir_appointment_id])
  @@map("intakes")
}

// ── Consultation ─────────────────────────────────────────────────────────────

/** Lifecycle status of a virtual consultation session. */
enum ConsultationStatus {
  WAITING   // room provisioned, waiting for participants to join
  ACTIVE    // consultation is in progress
  COMPLETED // ended normally — reports written
  ABANDONED // ended without a SOAP report
}

/**
 * Virtual consultation session.
 *
 * Covers the full lifecycle of a video appointment:
 *   WAITING → (participants join) → ACTIVE → (doctor ends) → COMPLETED
 *
 * Stores the LiveKit room ID, the real-time transcript captured during the
 * call, the SOAP note and full merged report generated by the AI agents at
 * the end of the consultation, and the FHIR clinical resources extracted
 * from the SOAP note in the post-consultation review step.
 *
 * FHIR-GQL has no native concept for virtual rooms, transcripts, or
 * AI-generated reports, so all data lives in local Postgres linked to the
 * FHIR Appointment by fhir_appointment_id (1:1).
 *
 * Write sequence:
 *   1. createConsultation()       — on booking success
 *   2. completeConsultation()     — on doctor end-call, writes reports
 *   3. saveClinicalData()         — post-consultation, writes FHIR resources
 */
model Consultation {
  id                  Int                @id @default(autoincrement())
  /** FHIR Appointment.id — 1:1 link back to the appointment. */
  fhir_appointment_id Int                @unique
  /** Better Auth user ID of the patient who booked. */
  user_id             String
  org_id              String?

  /** LiveKit room name used for token generation (e.g. "room_AB1C2D"). */
  room_id             String             @unique
  status              ConsultationStatus @default(WAITING)

  /**
   * Real-time transcript captured during the call.
   * Shape: [{ speaker: "DOCTOR" | "PATIENT", text: string, timestamp: string }]
   */
  virtual_conversation Json?

  /**
   * SOAP note from doctor-report-agent.
   * Shape: { subjective, objective, assessment, plan, summary }
   */
  soap_note           Json?

  /**
   * Merged report from full-report-agent (SOAP + assessment plan).
   * Shape: { soap_report, assessment_plan, generated_at }
   */
  full_report         Json?

  /** ServiceRequest[] extracted by clinical-extraction-agent (FHIR R4 shape, stored as JSON). */
  service_requests    Json?
  /** MedicationRequest[] extracted by clinical-extraction-agent (FHIR R4 shape, stored as JSON). */
  medication_requests Json?
  /** Observation[] extracted by clinical-extraction-agent (FHIR R4 shape, stored as JSON). */
  observations        Json?
  /** Condition[] extracted by clinical-extraction-agent (FHIR R4 shape, stored as JSON). */
  conditions          Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@map("consultations")
}

// ── EMR Chat Session ──────────────────────────────────────────────────────────

enum EmrChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum EmrMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmrMessageType {
  TEXT
  WORKFLOW_START
  WORKFLOW_STEP
  WORKFLOW_COMPLETE
  WORKFLOW_ABANDONED
  WORKFLOW_ERROR
}

enum EmrWorkflowStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  ERROR
}

/**
 * Top-level chat session. One session = one conversation thread.
 * A session can contain plain text exchanges and one or more workflow runs.
 */
model EmrChatSession {
  id        String               @id @default(uuid())
  userId    String
  orgId     String?
  title     String?
  status    EmrChatSessionStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  messages       EmrChatMessage[]
  workflowStates EmrWorkflowState[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

/**
 * One message in a chat session. Stores text content and a type tag so the
 * UI knows whether to render a plain bubble, a tool call card, or a workflow
 * banner. Optional metadata JSON holds tool call details, workflow snapshots, etc.
 */
model EmrChatMessage {
  id        String         @id @default(uuid())
  sessionId String
  role      EmrMessageRole
  content   String
  type      EmrMessageType @default(TEXT)
  metadata  Json?
  createdAt DateTime       @default(now())

  session       EmrChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workflowState EmrWorkflowState?

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

/**
 * Persists the full state of one workflow run so the user can leave mid-flow
 * and resume exactly where they left off. Stores the full WorkflowDefinition
 * JSON and the accumulated sessionContext (FHIR IDs etc.).
 */
model EmrWorkflowState {
  id               String @id @default(uuid())
  sessionId        String
  triggerMessageId String? @unique

  workflowDefinition Json
  workflowId         String
  workflowName       String

  currentStepIndex Int @default(0)
  totalSteps       Int

  sessionContext Json @default("{}")

  status      EmrWorkflowStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt

  session         EmrChatSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerMessage  EmrChatMessage?             @relation(fields: [triggerMessageId], references: [id])
  stepSubmissions EmrWorkflowStepSubmission[]

  @@index([sessionId])
  @@index([sessionId, status])
}

/**
 * Audit trail of every form step the user submitted within a workflow.
 * Stores inputs, FHIR response, and extracted outputs that were merged into
 * sessionContext. stepIndex is unique per workflow state — only one submission per step.
 */
model EmrWorkflowStepSubmission {
  id              String @id @default(uuid())
  workflowStateId String
  stepIndex       Int
  stepId          String
  stepName        String
  actionName      String

  formData         Json
  responseData     Json?
  extractedOutputs Json?

  submittedAt DateTime @default(now())

  workflowState EmrWorkflowState @relation(fields: [workflowStateId], references: [id], onDelete: Cascade)

  @@index([workflowStateId])
  @@unique([workflowStateId, stepIndex])
}
