
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Test {
    id String @id @default(uuid())
    name String
}

// ── EMR Chat Session ──────────────────────────────────────────────────────────

enum EmrChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum EmrMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmrMessageType {
  TEXT
  WORKFLOW_START
  WORKFLOW_STEP
  WORKFLOW_COMPLETE
  WORKFLOW_ABANDONED
  WORKFLOW_ERROR
}

enum EmrWorkflowStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  ERROR
}

/**
 * Top-level chat session. One session = one conversation thread.
 * A session can contain plain text exchanges and one or more workflow runs.
 */
model EmrChatSession {
  id        String               @id @default(uuid())
  userId    String
  orgId     String?
  title     String?
  status    EmrChatSessionStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  messages       EmrChatMessage[]
  workflowStates EmrWorkflowState[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

/**
 * One message in a chat session. Stores text content and a type tag so the
 * UI knows whether to render a plain bubble, a tool call card, or a workflow
 * banner. Optional metadata JSON holds tool call details, workflow snapshots, etc.
 */
model EmrChatMessage {
  id        String         @id @default(uuid())
  sessionId String
  role      EmrMessageRole
  content   String
  type      EmrMessageType @default(TEXT)
  metadata  Json?
  createdAt DateTime       @default(now())

  session       EmrChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workflowState EmrWorkflowState?

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

/**
 * Persists the full state of one workflow run so the user can leave mid-flow
 * and resume exactly where they left off. Stores the full WorkflowDefinition
 * JSON and the accumulated sessionContext (FHIR IDs etc.).
 */
model EmrWorkflowState {
  id               String @id @default(uuid())
  sessionId        String
  triggerMessageId String? @unique

  workflowDefinition Json
  workflowId         String
  workflowName       String

  currentStepIndex Int @default(0)
  totalSteps       Int

  sessionContext Json @default("{}")

  status      EmrWorkflowStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt

  session         EmrChatSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerMessage  EmrChatMessage?             @relation(fields: [triggerMessageId], references: [id])
  stepSubmissions EmrWorkflowStepSubmission[]

  @@index([sessionId])
  @@index([sessionId, status])
}

/**
 * Audit trail of every form step the user submitted within a workflow.
 * Stores inputs, FHIR response, and extracted outputs that were merged into
 * sessionContext. stepIndex is unique per workflow state — only one submission per step.
 */
model EmrWorkflowStepSubmission {
  id              String @id @default(uuid())
  workflowStateId String
  stepIndex       Int
  stepId          String
  stepName        String
  actionName      String

  formData         Json
  responseData     Json?
  extractedOutputs Json?

  submittedAt DateTime @default(now())

  workflowState EmrWorkflowState @relation(fields: [workflowStateId], references: [id], onDelete: Cascade)

  @@index([workflowStateId])
  @@unique([workflowStateId, stepIndex])
}
