# Copy to hosted.env and fill in real values. hosted.env is gitignored.
#
# Same shape as local.env.example, pointed at the hosted deployment instead of
# localhost. Use a test doctor account and clearly-synthetic patient/practitioner
# ids on this profile — this writes real records into whatever FHIR_GQL_URL points at.

BETTER_AUTH_URL=https://your-hosted-iam.example.com
FHIR_GQL_URL=https://your-hosted-fhir-gql.example.com/api/v1

SEED_DOCTOR_EMAIL=doctor@example.com
SEED_DOCTOR_PASSWORD=change-me

SEED_DEFAULT_PATIENT_ID=
SEED_DEFAULT_PRACTITIONER_ID=
