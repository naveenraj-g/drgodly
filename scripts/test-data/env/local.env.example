# Copy to local.env and fill in real values. local.env is gitignored.
#
# Points the seed script at your local dev stack — same values as .env.example
# at the repo root (BETTER_AUTH_URL / FHIR_GQL_URL), since the script talks to
# those backends directly rather than through the Next.js app.

BETTER_AUTH_URL=http://localhost:5001
FHIR_GQL_URL=http://localhost:8005/api/v1

# A test doctor account that exists in your local IAM, with a linked
# Practitioner FHIR profile.
SEED_DOCTOR_EMAIL=doctor@example.com
SEED_DOCTOR_PASSWORD=change-me

# Optional — used when --patient-id/--practitioner-id aren't passed on the CLI.
SEED_DEFAULT_PATIENT_ID=
SEED_DEFAULT_PRACTITIONER_ID=
