{
  "id": "org-location-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "org-location-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_location" },
        "submitLabel": { "literalString": "Create Location" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 2: Create Location" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Define the physical location for this organisation." },
              "usageHint": "caption"
            }
          },
          {
            "id": "summary-org",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Linked Organisation: Organization/$organization_id" },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "section-core",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Location Details" },
              "usageHint": "h4"
            }
          },
          {
            "id": "loc-name-status-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "name",
                  "type": "TextField",
                  "weight": 2,
                  "properties": {
                    "label": { "literalString": "Location Name" },
                    "placeholder": { "literalString": "e.g. Main Building" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "status",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Status" },
                    "placeholder": { "literalString": "Search status…" },
                    "items": "$location_status_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                }
              ]
            }
          },
          {
            "id": "mode",
            "type": "MultipleChoice",
            "properties": {
              "label": { "literalString": "Mode (optional)" },
              "placeholder": { "literalString": "Select mode" },
              "items": [
                { "label": { "literalString": "Instance — a specific physical place" }, "value": "instance" },
                { "label": { "literalString": "Kind — a class of places" }, "value": "kind" }
              ]
            }
          },
          {
            "id": "description",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Description (optional)" },
              "placeholder": { "literalString": "e.g. Primary hospital building, 3rd floor" },
              "textFieldType": "longText"
            }
          },
          {
            "id": "physical_type",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Physical Type (optional)" },
              "placeholder": { "literalString": "Search physical type…" },
              "items": "$location_physical_type_concepts.concepts",
              "valueType": { "literalString": "CodeableConcept" }
            }
          },
          {
            "id": "divider-address",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "section-address",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Address (optional)" },
              "usageHint": "h4"
            }
          },
          {
            "id": "loc-use-type-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "address_use",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Address Use" },
                    "placeholder": { "literalString": "Search use…" },
                    "items": "$address_use_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "address_type",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Address Type" },
                    "placeholder": { "literalString": "Search type…" },
                    "items": "$address_type_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                }
              ]
            }
          },
          {
            "id": "address_line",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Street Address" },
              "placeholder": { "literalString": "e.g. 456 Hospital Drive" },
              "textFieldType": "shortText"
            }
          },
          {
            "id": "loc-city-state-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "address_city",
                  "type": "TextField",
                  "weight": 2,
                  "properties": {
                    "label": { "literalString": "City" },
                    "placeholder": { "literalString": "City" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "address_state",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "State" },
                    "placeholder": { "literalString": "State" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "loc-postal-country-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "address_postal_code",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Postal Code" },
                    "placeholder": { "literalString": "ZIP / Postal code" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "address_country",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Country" },
                    "placeholder": { "literalString": "e.g. US" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "divider-extra",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "availability_exceptions",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Availability Exceptions (optional)" },
              "placeholder": { "literalString": "e.g. Closed on public holidays" },
              "textFieldType": "longText"
            }
          }
        ]
      }
    }
  }
}
