{
  "id": "add-conditions-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "add-conditions-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_conditions_batch" },
        "secondaryAction": {
          "name": "back_to_choose",
          "label": { "literalString": "← Change Categories" },
          "variant": "outline"
        },
        "submitLabel": { "literalString": "Save Conditions & Continue →" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "ac-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 3 of 6 · Add Conditions & Diagnoses" },
              "usageHint": "h3"
            }
          },
          {
            "id": "ac-form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Add one or more diagnoses or clinical findings for this encounter. Each condition is submitted and audited individually."
              },
              "usageHint": "caption"
            }
          },
          { "id": "ac-divider-existing", "type": "Divider", "properties": {} },
          {
            "id": "ac-existing-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Existing Encounter Findings" },
              "usageHint": "h5"
            }
          },
          {
            "id": "ac-existing-suffix",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "📋 $existing_conditions.total condition(s) already recorded for this encounter."
              },
              "usageHint": "caption"
            }
          },
          { "id": "ac-divider-new", "type": "Divider", "properties": {} },
          {
            "id": "conditions_group",
            "type": "RepeatableGroup",
            "properties": {
              "label": { "literalString": "New Conditions to Add" },
              "addLabel": { "literalString": "Add Another Condition" },
              "defaultCount": 1,
              "minItems": 1,
              "maxItems": 10,
              "allowDuplicate": false,
              "template": [
                {
                  "id": "code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Diagnosis (ICD-10 / SNOMED CT)" },
                    "placeholder": { "literalString": "Search diagnoses by name or code…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": { "minChars": 2, "debounceMs": 200 }
                  }
                },
                {
                  "id": "cond-status-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "clinical_status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Clinical Status" },
                          "placeholder": { "literalString": "Select status…" },
                          "items": "$clinical_status_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      },
                      {
                        "id": "verification_status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Verification Status" },
                          "placeholder": { "literalString": "Select verification…" },
                          "items": "$verification_status_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "cond-meta-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "severity",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Severity" },
                          "placeholder": { "literalString": "Select severity…" },
                          "items": "$severity_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      },
                      {
                        "id": "category",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Category" },
                          "placeholder": { "literalString": "Select category…" },
                          "items": "$category_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
