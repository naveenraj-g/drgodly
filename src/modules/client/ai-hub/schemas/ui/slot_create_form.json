{
  "id": "slot-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "slot-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_slot" },
        "submitLabel": { "literalString": "Create Slots" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 2: Add Slots" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Add individual bookable time slots for Schedule/$schedule_id." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "slots",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Slot" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "status",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Status" },
                    "placeholder": { "literalString": "Search status…" },
                    "items": "$slot_status_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "slot-time-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "start",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Start" },
                          "enableDate": true,
                          "enableTime": true
                        }
                      },
                      {
                        "id": "end",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "End" },
                          "enableDate": true,
                          "enableTime": true
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "appointment_type",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Appointment Type (optional)" },
                    "placeholder": { "literalString": "Search type…" },
                    "items": "$appointment_type_concepts.concepts",
                    "valueType": { "literalString": "CodeableConcept" }
                  }
                },
                {
                  "id": "comment",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Comment (optional)" },
                    "placeholder": { "literalString": "e.g. First slot of the day" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
