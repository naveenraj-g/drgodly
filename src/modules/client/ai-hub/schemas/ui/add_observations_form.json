{
  "id": "add-observations-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "add-observations-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_observations_batch" },
        "secondaryAction": {
          "name": "back_to_choose",
          "label": { "literalString": "← Change Categories" },
          "variant": "outline"
        },
        "submitLabel": { "literalString": "Save Observations & Continue →" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "ao-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 4 of 6 · Add Clinical Observations" },
              "usageHint": "h3"
            }
          },
          {
            "id": "ao-form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Record one or more clinical observations, vital measurements, or laboratory findings. Status is required for FHIR compliance."
              },
              "usageHint": "caption"
            }
          },
          { "id": "ao-divider-existing", "type": "Divider", "properties": {} },
          {
            "id": "ao-existing-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Existing Encounter Observations" },
              "usageHint": "h5"
            }
          },
          {
            "id": "ao-existing-suffix",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "🔬 $existing_observations.total observation(s) already recorded for this encounter."
              },
              "usageHint": "caption"
            }
          },
          { "id": "ao-divider-new", "type": "Divider", "properties": {} },
          {
            "id": "observations_group",
            "type": "RepeatableGroup",
            "properties": {
              "label": { "literalString": "Observations to Record" },
              "addLabel": { "literalString": "Add Another Observation" },
              "defaultCount": 1,
              "minItems": 1,
              "maxItems": 10,
              "allowDuplicate": false,
              "template": [
                {
                  "id": "code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "LOINC Observation / Measurement Code" },
                    "placeholder": { "literalString": "Search LOINC codes by name…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "system": "http://loinc.org",
                      "minChars": 2,
                      "debounceMs": 200
                    }
                  }
                },
                {
                  "id": "obs-status-cat-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Status *" },
                          "placeholder": { "literalString": "Select status…" },
                          "items": "$status_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "category",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Category" },
                          "placeholder": { "literalString": "Select category…" },
                          "items": "$category_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "obs-interp-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "interpretation",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Interpretation" },
                          "placeholder": { "literalString": "Select interpretation (Normal, High, Low)…" },
                          "items": "$interpretation_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "obs-value-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "value",
                        "type": "TextField",
                        "weight": 2,
                        "properties": {
                          "label": { "literalString": "Measured Value" },
                          "placeholder": { "literalString": "e.g. 120/80, 98.6, or text result" },
                          "textFieldType": "text"
                        }
                      },
                      {
                        "id": "value_quantity_unit",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Unit of Measure" },
                          "placeholder": { "literalString": "e.g. mmHg, °F, mg/dL" },
                          "textFieldType": "text"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
