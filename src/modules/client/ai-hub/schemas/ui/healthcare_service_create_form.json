{
  "id": "hcs-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "hcs-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_healthcare_service" },
        "submitLabel": { "literalString": "Create Service" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Create Healthcare Service" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Register a service offered by your organisation, including classification, specialty, and available hours." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "section-core",
            "type": "Text",
            "properties": { "text": { "literalString": "Service Details" }, "usageHint": "h4" }
          },
          {
            "id": "hcs-name-active-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "name",
                  "type": "TextField",
                  "weight": 3,
                  "properties": { "label": { "literalString": "Service Name" }, "placeholder": { "literalString": "e.g. General Practice Consultation" }, "textFieldType": "shortText" }
                },
                {
                  "id": "active",
                  "type": "CheckBox",
                  "weight": 1,
                  "properties": { "label": { "literalString": "Active" }, "value": { "literalBoolean": true } }
                }
              ]
            }
          },
          {
            "id": "appointment_required",
            "type": "CheckBox",
            "properties": { "label": { "literalString": "Appointment Required" }, "value": { "literalBoolean": false } }
          },
          {
            "id": "comment",
            "type": "TextField",
            "properties": { "label": { "literalString": "Comment (optional)" }, "placeholder": { "literalString": "e.g. Walk-in and appointment-based service" }, "textFieldType": "longText" }
          },
          { "id": "divider-class", "type": "Divider", "properties": {} },
          {
            "id": "section-class",
            "type": "Text",
            "properties": { "text": { "literalString": "Classification" }, "usageHint": "h4" }
          },
          {
            "id": "service_category",
            "type": "TerminologySelect",
            "properties": { "label": { "literalString": "Service Category (optional)" }, "placeholder": { "literalString": "Search category…" }, "items": "$service_category_concepts.concepts", "valueType": { "literalString": "CodeableConcept" } }
          },
          {
            "id": "service_type",
            "type": "TerminologySelect",
            "properties": { "label": { "literalString": "Service Type (optional)" }, "placeholder": { "literalString": "Search service type…" }, "items": "$service_type_concepts.concepts", "valueType": { "literalString": "CodeableConcept" } }
          },
          {
            "id": "specialty",
            "type": "TerminologySelect",
            "properties": { "label": { "literalString": "Specialty (optional)" }, "placeholder": { "literalString": "Search specialty…" }, "items": "$specialty_concepts.concepts", "valueType": { "literalString": "CodeableConcept" } }
          },
          { "id": "divider-links", "type": "Divider", "properties": {} },
          {
            "id": "section-links",
            "type": "Text",
            "properties": { "text": { "literalString": "Organisation & Location" }, "usageHint": "h4" }
          },
          {
            "id": "org",
            "type": "DataSelect",
            "properties": {
              "label": { "literalString": "Provided By (Organisation)" },
              "placeholder": { "literalString": "Search organisation…" },
              "items": "$my_organizations.data",
              "labelPath": "name",
              "emits": [
                { "key": "ref_id", "path": "id" },
                { "key": "display", "path": "name" }
              ]
            }
          },
          {
            "id": "location",
            "type": "DataSelect",
            "properties": {
              "label": { "literalString": "Location (optional)" },
              "placeholder": { "literalString": "Search location…" },
              "items": "$my_locations.data",
              "labelPath": "name",
              "emits": [
                { "key": "ref_id", "path": "id" },
                { "key": "display", "path": "name" }
              ]
            }
          },
          { "id": "divider-avail", "type": "Divider", "properties": {} },
          {
            "id": "section-avail",
            "type": "Text",
            "properties": { "text": { "literalString": "Available Hours (optional)" }, "usageHint": "h4" }
          },
          {
            "id": "available_time",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Hours" },
              "minItems": { "literalNumber": 0 },
              "defaultCount": { "literalNumber": 0 },
              "template": [
                {
                  "id": "days",
                  "type": "TextField",
                  "properties": { "label": { "literalString": "Days (comma-separated)" }, "placeholder": { "literalString": "mon,tue,wed,thu,fri" }, "textFieldType": "shortText" }
                },
                {
                  "id": "avail-times-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "available_start_time",
                        "type": "TextField",
                        "weight": 1,
                        "properties": { "label": { "literalString": "Opens" }, "placeholder": { "literalString": "09:00:00" }, "textFieldType": "shortText" }
                      },
                      {
                        "id": "available_end_time",
                        "type": "TextField",
                        "weight": 1,
                        "properties": { "label": { "literalString": "Closes" }, "placeholder": { "literalString": "17:00:00" }, "textFieldType": "shortText" }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "id": "availability_exceptions",
            "type": "TextField",
            "properties": { "label": { "literalString": "Availability Exceptions (optional)" }, "placeholder": { "literalString": "e.g. Closed on public holidays" }, "textFieldType": "longText" }
          }
        ]
      }
    }
  }
}
