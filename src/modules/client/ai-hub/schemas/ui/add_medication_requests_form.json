{
  "id": "add-medication-requests-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "add-medication-requests-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_medication_requests_batch" },
        "secondaryAction": {
          "name": "back_to_choose",
          "label": { "literalString": "← Change Categories" },
          "variant": "outline"
        },
        "submitLabel": { "literalString": "Save Prescriptions & Continue →" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "amr-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 5 of 6 · Add Medication Requests" },
              "usageHint": "h3"
            }
          },
          {
            "id": "amr-form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Add one or more prescription orders for this consultation. Status and clinical intent are required."
              },
              "usageHint": "caption"
            }
          },
          { "id": "amr-divider-existing", "type": "Divider", "properties": {} },
          {
            "id": "amr-existing-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Existing Encounter Prescriptions" },
              "usageHint": "h5"
            }
          },
          {
            "id": "amr-existing-suffix",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "💊 $existing_medication_requests.total medication request(s) already recorded for this encounter."
              },
              "usageHint": "caption"
            }
          },
          { "id": "amr-divider-new", "type": "Divider", "properties": {} },
          {
            "id": "medication_requests_group",
            "type": "RepeatableGroup",
            "properties": {
              "label": { "literalString": "Prescriptions to Add" },
              "addLabel": { "literalString": "Add Another Prescription" },
              "defaultCount": 1,
              "minItems": 1,
              "maxItems": 10,
              "allowDuplicate": false,
              "template": [
                {
                  "id": "medication_code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Medication (RxNorm Drug Name / Code)" },
                    "placeholder": { "literalString": "Search drugs in RxNorm…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
                      "minChars": 2,
                      "debounceMs": 200
                    }
                  }
                },
                {
                  "id": "amr-order-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Status *" },
                          "placeholder": { "literalString": "Select status…" },
                          "items": "$status_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "intent",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Intent *" },
                          "placeholder": { "literalString": "Select intent (e.g. order)…" },
                          "items": "$intent_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "dosage_text",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Dosage Instructions" },
                    "placeholder": { "literalString": "e.g. 1 tablet orally twice daily with meals" },
                    "textFieldType": "text"
                  }
                },
                {
                  "id": "route",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Administration Route (optional)" },
                    "placeholder": { "literalString": "Search route (e.g. Oral, Intravenous)…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": { "minChars": 2, "debounceMs": 200 }
                  }
                },
                {
                  "id": "amr-dispense-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "dispense_quantity",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Dispense Quantity" },
                          "placeholder": { "literalString": "e.g. 30" },
                          "textFieldType": "text"
                        }
                      },
                      {
                        "id": "dispense_unit",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Unit" },
                          "placeholder": { "literalString": "tablets, mL" },
                          "textFieldType": "text"
                        }
                      },
                      {
                        "id": "repeats",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Refills / Repeats" },
                          "placeholder": { "literalString": "e.g. 0, 1, 2" },
                          "textFieldType": "text"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
