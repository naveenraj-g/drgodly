{
  "id": "schedule-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "schedule-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_schedule" },
        "submitLabel": { "literalString": "Create Schedule" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 1: Create Schedule" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Define the planning horizon and link to a practitioner role. Slots will be added in the next step." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "actor",
            "type": "DataSelect",
            "properties": {
              "label": { "literalString": "Practitioner" },
              "placeholder": { "literalString": "Search practitioner…" },
              "items": "$booking_practitioners.data",
              "labelPath": "practitioner_detail.name.text",
              "descriptionPath": "specialty.0.coding_display",
              "emits": [
                { "key": "role_id", "path": "id" },
                { "key": "display", "path": "practitioner_detail.name.text" }
              ]
            }
          },
          {
            "id": "sched-active-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "active",
                  "type": "CheckBox",
                  "weight": 1,
                  "properties": { "label": { "literalString": "Active" }, "value": { "literalBoolean": true } }
                },
                {
                  "id": "planning_horizon_start",
                  "type": "DateTimeInput",
                  "weight": 2,
                  "properties": { "label": { "literalString": "Horizon Start" }, "enableDate": true, "enableTime": true }
                },
                {
                  "id": "planning_horizon_end",
                  "type": "DateTimeInput",
                  "weight": 2,
                  "properties": { "label": { "literalString": "Horizon End" }, "enableDate": true, "enableTime": true }
                }
              ]
            }
          },
          {
            "id": "specialty",
            "type": "TerminologySelect",
            "properties": { "label": { "literalString": "Specialty (optional)" }, "placeholder": { "literalString": "Search specialty…" }, "items": "$specialty_concepts.concepts", "valueType": { "literalString": "CodeableConcept" } }
          },
          {
            "id": "service_type",
            "type": "TerminologySelect",
            "properties": { "label": { "literalString": "Service Type (optional)" }, "placeholder": { "literalString": "Search service type…" }, "items": "$service_type_concepts.concepts", "valueType": { "literalString": "CodeableConcept" } }
          },
          {
            "id": "comment",
            "type": "TextField",
            "properties": { "label": { "literalString": "Comment (optional)" }, "placeholder": { "literalString": "e.g. Dr. Smith — Mon/Wed/Fri mornings" }, "textFieldType": "shortText" }
          }
        ]
      }
    }
  }
}
