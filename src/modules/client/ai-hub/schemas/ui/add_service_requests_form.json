{
  "id": "add-service-requests-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "add-service-requests-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_service_requests_batch" },
        "secondaryAction": {
          "name": "back_to_choose",
          "label": { "literalString": "← Change Categories" },
          "variant": "outline"
        },
        "submitLabel": { "literalString": "Save Service Requests & Complete →" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "asr-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 6 of 6 · Add Service Requests & Orders" },
              "usageHint": "h3"
            }
          },
          {
            "id": "asr-form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Order lab tests, diagnostic imaging, specialist referrals, or procedure requests for this consultation."
              },
              "usageHint": "caption"
            }
          },
          { "id": "asr-divider-existing", "type": "Divider", "properties": {} },
          {
            "id": "asr-existing-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Existing Encounter Orders" },
              "usageHint": "h5"
            }
          },
          {
            "id": "asr-existing-suffix",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "📋 $existing_service_requests.total service request(s) already recorded for this encounter."
              },
              "usageHint": "caption"
            }
          },
          { "id": "asr-divider-new", "type": "Divider", "properties": {} },
          {
            "id": "service_requests_group",
            "type": "RepeatableGroup",
            "properties": {
              "label": { "literalString": "Orders to Request" },
              "addLabel": { "literalString": "Add Another Service Request" },
              "defaultCount": 1,
              "minItems": 1,
              "maxItems": 10,
              "allowDuplicate": false,
              "template": [
                {
                  "id": "code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Procedure / Test / Referral Code" },
                    "placeholder": { "literalString": "Search service or procedure codes…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": { "minChars": 2, "debounceMs": 200 }
                  }
                },
                {
                  "id": "asr-status-intent-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Status *" },
                          "placeholder": { "literalString": "Select status…" },
                          "items": "$status_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "intent",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Intent *" },
                          "placeholder": { "literalString": "Select intent (e.g. order)…" },
                          "items": "$intent_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "asr-prio-cat-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "priority",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Priority" },
                          "placeholder": { "literalString": "Select priority (Routine, Urgent, Stat)…" },
                          "items": "$priority_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "category",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Category" },
                          "placeholder": { "literalString": "Select category…" },
                          "items": "$category_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "patient_instruction",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Clinical Notes / Patient Instructions" },
                    "placeholder": { "literalString": "Fasting instructions, clinical indications, or specific details for the facility…" },
                    "textFieldType": "longText"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
